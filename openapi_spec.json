{
  "openapi": "3.1.0",
  "info": {
    "title": "Lab Critical Value Engine Demo API",
    "version": "3.0.1",
    "description": "Synthetic demonstration only; thresholds are not clinically validated."
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health (public)",
        "responses": {
          "200": {
            "description": "Service health"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Aggregate process metrics (public)",
        "responses": {
          "200": {
            "description": "JSON metrics"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Synthetic task evaluation",
        "responses": {
          "200": {
            "description": "Generic demo dossier"
          },
          "401": {
            "description": "Missing or invalid key"
          },
          "503": {
            "description": "API key not configured"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Deterministic mock response",
        "responses": {
          "200": {
            "description": "Demo reply"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "In-process signed audit-chain snapshot",
        "responses": {
          "200": {
            "description": "Audit log and verification result"
          }
        }
      }
    }
  }
}
